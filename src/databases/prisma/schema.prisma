// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String   @db.VarChar(150)
  slug         String   @unique @db.VarChar(80)
  logoUrl      String?  @map("logo_url") @db.VarChar(300)
  primaryColor String?  @map("primary_color") @db.VarChar(7)
  instagram    String?  @db.VarChar(100)
  whatsapp     String   @db.VarChar(20)
  status       Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users     User[]
  seasons   Season[]
  mountains Mountain[]

  @@map("companies")
}

// Enum: valores fijos permitidos para el campo `role` de `users`.
enum RoleType {
  customer
  admin
  superadmin
}

model User {
  id        String  @id @default(uuid(7)) @db.Uuid
  companyId String? @map("company_id") @db.Uuid

  name      String   @db.VarChar(150)
  lastname  String   @db.VarChar(150)
  username  String?  @db.VarChar(50)
  email     String?  @db.VarChar(150)
  phone     String?  @db.VarChar(20)
  role      RoleType @default(admin)
  status    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict) // referencia a companyId

  credentials UserCredential? // lado "uno" de la relación 1-a-1, opcional (no genera columna en la tabla)
  userSeasons UserSeason[]
  bookings    Booking[]

  // constraints UNIQUE compuestas reglas de negocio
  @@unique([companyId, email], map: "users_company_id_email_key")
  @@unique([companyId, phone], map: "users_company_id_phone_key")
  @@unique([companyId, username], map: "users_company_id_username_key")
  // índices simples
  @@index([companyId], map: "idx_users_company")
  @@index([email], map: "idx_users_email")
  @@index([phone], map: "idx_users_phone")
  @@index([username], map: "idx_users_name")
  @@map("users")
}

// Tabla separada para credenciales, en relación 1-a-1 con `users`.
model UserCredential {
  id     Int    @id @default(autoincrement())
  userId String @unique @map("user_id") @db.Uuid // FK hacia users.id; @unique es lo que fuerza que sea 1-a-1 (si no, sería 1-a-muchos)

  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade) // si se borra el user, se borran sus credenciales

  @@map("user_credentials")
}

model Season {
  id        Int     @id @default(autoincrement())
  companyId String? @map("company_id") @db.Uuid

  name      String   @db.VarChar(100)
  year      Int      @db.Integer
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(true) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  userSeasons     UserSeason[]
  seasonMountains SeasonMountain[]

  // @@unique([companyId, year], map: "seasons_company_id_year_key")

  @@unique([companyId, year, name], map: "seasons_company_id_year_name_key")
  @@index([companyId], map: "idx_seasons_company")
  @@map("seasons")
}

model Mountain {
  id        Int     @id @default(autoincrement())
  companyId String? @map("company_id") @db.Uuid

  name                 String   @db.VarChar(100)
  altitudeMeters       Float    @map("altitude_meters") @db.DoublePrecision
  location             String   @db.VarChar(150)
  generalDescription   String?  @map("general_description") @db.Text
  technicalDescription String?  @map("technical_description") @db.Text
  status               Boolean  @default(true)
  imageUrl             String?  @map("image_url") @db.VarChar(300)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  seasonMountains SeasonMountain[]

  @@index([companyId], map: "idx_mountains_company")
  @@map("mountains")
}

model SeasonMountain {
  id         Int  @id @default(autoincrement())
  seasonId   Int? @map("season_id")
  mountainId Int? @map("mountain_id")

  sortOrder Int       @map("sort_order") @db.SmallInt
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  price     Decimal   @db.Decimal(10, 2)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  season   Season?   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  mountain Mountain? @relation(fields: [mountainId], references: [id], onDelete: Restrict)

  bookings Booking[]

  @@unique([seasonId, mountainId], map: "season_mountains_season_id_mountain_id_key")
  @@unique([seasonId, sortOrder], map: "season_mountains_season_id_sort_order_key")
  @@index([seasonId], map: "idx_sm_season")
  @@map("season_mountains")
}

model UserSeason {
  id       Int     @id @default(autoincrement())
  userId   String? @map("user_id") @db.Uuid
  seasonId Int?    @map("season_id")

  status     Boolean  @default(true)
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId], map: "user_seasons_user_id_season_id_key")
  @@index([userId], map: "idx_us_user")
  @@index([seasonId], map: "idx_us_season")
  @@map("user_seasons")
}

model Booking {
  id               String  @id @default(uuid(7)) @db.Uuid
  userId           String? @map("user_id") @db.Uuid
  seasonMountainId Int?    @map("season_mountain_id")

  createdBy String?  @map("created_by") @db.Uuid
  status    Boolean  @default(true)
  bookedAt  DateTime @default(now()) @map("booked_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonMountain SeasonMountain? @relation(fields: [seasonMountainId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonMountainId], map: "bookings_user_id_season_mountain_id_key")
  @@index([userId], map: "idx_bookings_user")
  @@index([seasonMountainId], map: "idx_bookings_season_mountain")
  @@map("bookings")
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Enum: valores fijos permitidos para el campo `role` de `users`.
enum RoleType {
  customer
  admin
  superadmin
}

model users {
  id          String            @id @default(uuid(7)) // PK, UUID v7 (ordenable por tiempo) generado por la base
  name        String            @db.VarChar(150)
  lastname    String            @db.VarChar(150)
  username    String            @unique @db.VarChar(50) // @unique crea un índice único, no permite duplicados
  email       String            @unique @db.VarChar(150)
  phone       String?           @db.VarChar(20) // el `?` lo hace opcional/nullable
  role        RoleType          @default(admin)
  status      Boolean           @default(true)
  created_at  DateTime          @default(now()) // se setea solo al crear el registro
  updated_at  DateTime          @updatedAt // Prisma la actualiza sola en cada update
  credentials user_credentials? // lado "uno" de la relación 1-a-1, opcional (no genera columna en la tabla)
}

// Tabla separada para credenciales, en relación 1-a-1 con `users`.
model user_credentials {
  id         Int      @id @default(autoincrement()) // PK numérica autoincremental (SERIAL en Postgres)
  user_id    String   @unique // FK hacia users.id; @unique es lo que fuerza que sea 1-a-1 (si no, sería 1-a-muchos)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade) // si se borra el user, se borran sus credenciales
  password   String   @db.VarChar(255) // guardar siempre el hash, nunca el password en texto plano
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
